{
  "info": {
    "name": "Guard Monitor - Push Notifications (FCM)",
    "description": "Standalone push API: login, register device, test, broadcast, remove. Import with guard-monitor env. Run Admin Login + Guard Login first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j=pm.response.json();if(j.token){pm.environment.set('adminToken',j.token);}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Guard Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ali\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j=pm.response.json();if(j.token){pm.environment.set('guardToken',j.token);if(j.guardId)pm.environment.set('guardId',j.guardId);}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Push (FCM)",
      "item": [
        {
          "name": "Register guard device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/push/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<FCM_REGISTRATION_TOKEN>\",\n  \"platform\": \"android\",\n  \"deviceId\": \"guard-phone-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guardToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Push status (me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/push/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "status"
              ],
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guardToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin: test push to self",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/push/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "push",
                "test"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Guard Monitor test\",\n  \"body\": \"Push is working.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin: test push to a guard",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/push/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "push",
                "test"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Return to your area\",\n  \"body\": \"You left the site.\",\n  \"guardId\": \"<GUARD_ID>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Admin: broadcast",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/push/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "push",
                "send"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Shift reminder\",\n  \"body\": \"Night shift starts at 20:00.\",\n  \"guardIds\": [\"<GUARD_ID>\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Remove device (logout)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/push/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "push",
                "token"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"guard-phone-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{guardToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
