PORT=3000
MONGO_URI=mongodb://localhost:27017/guard-monitor
DATA_DIR=./data
UPLOAD_DIR=./data
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASS=admin123
CORS_ORIGIN=*
TZ=Asia/Karachi
# WEBHOOK_URL=
# OUTSIDE_READINGS_TO_ALERT=2
# MAX_ACCURACY_M=100
# NO_SIGNAL_AFTER_SEC=120
# ESCALATE_AFTER_SEC=300
# LATE_GRACE_MIN=10
# HOURLY_EARLY_MIN=5
# HOURLY_LATE_MIN=5
# Shift-hour enforcement: check-in / check-out / hourly photos allowed ONLY
# inside [shift.start - EARLY, shift.end + END_GRACE]. Watchdog auto-closes
# stale open attendance SHIFT_AUTO_CLOSE_AFTER_MIN after shift end.
# SHIFT_CHECKIN_EARLY_MIN=30
# SHIFT_END_GRACE_MIN=60
# SHIFT_AUTO_CLOSE_AFTER_MIN=120
# MAX_PHOTO_MB=5
# Push notifications (FCM via firebase-admin).
# Get values from Firebase Console -> Project Settings -> Service Accounts.
# If left empty, push is disabled but the API + Socket.IO still work.
# PUSH_ENABLED=true
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
